{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ngoding5/schemas/problem.schema.json",
  "title": "Soal Tulis Kode Ngoding5",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "revision", "tema", "level", "title", "desc", "function", "tests", "hints", "explanation", "solutions", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "tema": { "type": "string" },
    "level": { "enum": ["Mudah", "Sedang", "Sulit"] },
    "title": { "type": "string", "minLength": 2, "maxLength": 80 },
    "desc": { "type": "string", "minLength": 10 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "params", "returns"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "params": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "type": { "$ref": "#/definitions/type" }
            }
          }
        },
        "returns": { "$ref": "#/definitions/type" }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["args", "expected"],
        "properties": {
          "args": { "type": "array" },
          "expected": {},
          "hidden": { "type": "boolean" }
        }
      }
    },
    "compare": { "enum": ["exact", "float", "unordered"] },
    "hints": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 5 } },
    "explanation": { "type": "string", "pattern": "^[a-z0-9-]+\\.md$" },
    "commonMistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 5 },
          "failsTest": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "solutions": {
      "type": "object",
      "required": ["javascript", "python"],
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["passed", "at"],
        "properties": {
          "passed": { "type": "boolean" },
          "at": { "type": "string" },
          "runtime": { "type": "string" }
        }
      }
    },
    "source": { "enum": ["bank", "generated", "migrated", "community"] },
    "generator": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "topik": { "type": ["string", "null"] }
      }
    },
    "createdAt": { "$ref": "#/definitions/date" },
    "updatedAt": { "$ref": "#/definitions/date" }
  },
  "definitions": {
    "type": { "enum": ["int", "float", "bool", "str", "int[]", "str[]", "int[][]", "dict<str,int>"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
